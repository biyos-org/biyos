@PACKAGE_INIT@

include(${CMAKE_CURRENT_LIST_DIR}/biyosTargets.cmake)

get_target_property(biyos_kind biyos::biyos TYPE)
if(biyos_kind STREQUAL "STATIC_LIBRARY")
    enable_language(CXX)
    include(CMakeFindDependencyMacro)
    find_dependency(Threads)
endif()
unset(biyos_kind)

check_required_components(biyos)
