file(STRINGS ${header} defines REGEX "^#define BIYOS_")
file(STRINGS ${header} declarations REGEX "^BIYOS_API ")
set(constants "")
foreach(line IN LISTS defines)
    if(line MATCHES "^#define BIYOS_API")
        continue()
    endif()
    if(NOT line MATCHES "^#define (BIYOS_[A-Z0-9_]+) \\(?(-?[0-9]+)\\)?$")
        message(FATAL_ERROR "unread constant: ${line}")
    endif()
    string(APPEND constants "${CMAKE_MATCH_1} = ${CMAKE_MATCH_2}\n")
endforeach()
set(functions "")
foreach(line IN LISTS declarations)
    if(NOT line MATCHES "^BIYOS_API [^(]* \\**(BIYOS_[a-z][a-z0-9_]*)\\(")
        message(FATAL_ERROR "unread function: ${line}")
    endif()
    string(APPEND functions "    \"${CMAKE_MATCH_1}\",\n")
endforeach()
file(WRITE ${output} "${constants}\nFUNCTIONS = (\n${functions})\n")
